<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_blue"
    android:padding="16dp">

    <!-- Top bar -->
    <ImageView
        android:id="@+id/menuIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/menu"
        android:layout_alignParentStart="true"
        app:tint="#FFFFFF" />

    <ImageView
        android:id="@+id/notificationIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/notification"
        android:layout_alignParentEnd="true"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/profileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp" />

    <!-- Profile icon -->
    <ImageView
        android:id="@+id/profileIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/profile"
        android:layout_below="@id/profileTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/circle_background"
        android:padding="16dp" />

    <!-- Profile Form -->
    <LinearLayout
        android:id="@+id/profileForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/profileIcon"
        android:layout_marginTop="24dp">

        <!-- First & Last Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <EditText
                    android:id="@+id/firstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="givenName"
                    android:background="@drawable/edittext_background"
                    android:enabled="false"
                    android:hint="First"
                    android:inputType="textPersonName"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    android:textColorHint="@color/black" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <EditText
                    android:id="@+id/lastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="familyName"
                    android:background="@drawable/edittext_background"
                    android:enabled="false"
                    android:hint="Last"
                    android:inputType="textPersonName"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    android:textColorHint="@color/black" />
            </LinearLayout>
        </LinearLayout>

        <!-- DOB -->
        <EditText
            android:id="@+id/dob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="birthDate"
            android:background="@drawable/edittext_background"
            android:enabled="false"
            android:hint="MM/DD/YY"
            android:inputType="date"
            android:minHeight="48dp"
            android:padding="10dp"
            android:textColorHint="@color/black" />

        <!-- Age -->
<!--        <EditText-->
<!--            android:id="@+id/patientAge"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:minHeight="48dp"-->
<!--            android:inputType="numberDecimal"-->
<!--            android:autofillHints="age"-->
<!--            android:background="@drawable/edittext_background"-->
<!--            android:padding="10dp"-->
<!--            android:hint="Enter your age"-->
<!--            android:layout_marginTop="16dp"-->
<!--            android:enabled="false" />-->

        <!-- Address -->
        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:autofillHints="address"
            android:background="@drawable/edittext_background"
            android:enabled="false"
            android:gravity="top|start"
            android:hint="Enter Address"
            android:inputType="textPostalAddress"
            android:minHeight="48dp"
            android:minLines="2"
            android:padding="10dp"
            android:textColorHint="@color/black" />

        <!-- Email -->
        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/edittext_background"
            android:enabled="false"
            android:hint="Enter Email"
            android:inputType="textEmailAddress"
            android:minHeight="48dp"
            android:padding="10dp"
            android:textColorHint="@color/black" />

        <!-- Reason for Appointment -->
        <EditText
            android:id="@+id/reason"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:autofillHints="reason"
            android:background="@drawable/edittext_background"
            android:enabled="false"
            android:gravity="top|start"
            android:hint="Reason for appointment"
            android:minHeight="40dp"
            android:minLines="2"
            android:padding="10dp"
            android:textColorHint="@color/black" />

        <!-- Allotted Slot -->
        <EditText
            android:id="@+id/slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/edittext_background"
            android:enabled="false"
            android:hint="Time slot"
            android:minHeight="48dp"
            android:padding="10dp"
            android:textColorHint="@color/black" />
    </LinearLayout>

    <!-- Save Button -->
    <Button
        android:id="@+id/saveProfileBtn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_below="@id/profileForm"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="70dp"
        android:text="@string/save"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:padding="10dp"
        android:textSize="16sp"
        android:background="@drawable/gradient_button_bg"
        android:elevation="6dp" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="5dp">

        <ImageView
            android:id="@+id/homeNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/home"
            android:contentDescription="@string/home"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/specialityNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/speciality"
            android:contentDescription="@string/speciality"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/doctorNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/doctor"
            android:contentDescription="@string/doctor"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/appointmentNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/appointform"
            android:contentDescription="@string/appointment"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/communityNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/community"
            android:contentDescription="@string/community"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</RelativeLayout>
